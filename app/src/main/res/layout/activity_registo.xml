<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:isScrollContainer="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@color/backgroundColor">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainLayoutRegisto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="350dp"
        android:background="@color/backgroundColor"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.10" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.90" />

        <ImageButton
            android:id="@+id/btnBackRegisto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_voltar"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/colorPrimary"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnEliminarTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_eliminar_este_item"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="@color/colorNegative"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titleRegisto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/nova_transacao"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Descrição -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/itemLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Descrição"
            app:startIconDrawable="@drawable/ic_edit"
            app:startIconTint="@color/colorPrimary"
            app:boxBackgroundColor="@color/surfaceColor"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/titleRegisto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/regNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorPrimary"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Valor Monetário -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/valorLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_valor"
            app:startIconDrawable="@drawable/ic_euro"
            app:startIconTint="@color/colorPrimary"
            app:boxBackgroundColor="@color/surfaceColor"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/itemLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/regEmailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorPrimary"
                android:imeOptions="flagNoExtractUi"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Data de Vencimento -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dataLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Data de Vencimento"
            app:startIconDrawable="@drawable/ic_calendar"
            app:startIconTint="@color/colorPrimary"
            app:boxBackgroundColor="@color/surfaceColor"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/valorLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/regPhoneText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorPrimary"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campos de Senha do Perfil -->
        <Button
            android:id="@+id/btnAlterarSenhaPerfil"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Alterar palavra-passe"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:visibility="gone"
            app:icon="@drawable/ic_lock"
            app:iconTint="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dataLayout" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/senhaLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_palavra_passe"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/colorPrimary"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/colorPrimary"
            app:boxBackgroundColor="@color/surfaceColor"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/btnAlterarSenhaPerfil">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/regSenhaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorPrimary"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmarSenhaLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_confirmar_palavra_passe"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/colorPrimary"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/colorPrimary"
            app:boxBackgroundColor="@color/surfaceColor"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/senhaLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/regConfirmarSenhaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorPrimary"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnCancelarTrocaSenha"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cancelar alteração de palavra-passe"
            android:textColor="@color/colorNegative"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/confirmarSenhaLayout" />

        <!-- Seleção de Categoria (Etiqueta) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/categoriaLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/label_categoria"
            app:startIconDrawable="@drawable/ic_tag"
            app:startIconTint="@color/colorPrimary"
            app:boxBackgroundColor="@color/surfaceColor"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/btnCancelarTrocaSenha">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:longClickable="false"
                android:textColor="@color/textColorPrimary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Seleção de Tipo (Segmented Toggle Control) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTipoTransacao"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/categoriaLayout">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleDespesa"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DESPESA"
                android:textColor="@color/colorNegative"
                android:textStyle="bold"
                app:strokeColor="@color/colorNegative" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleRenda"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="RENDA"
                android:textColor="@color/colorPositive"
                android:textStyle="bold"
                app:strokeColor="@color/colorPositive" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Lógica de Recorrência com Único Switch -->
        <LinearLayout
            android:id="@+id/llRecorrenciaOpcoes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/toggleTipoTransacao">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRecorrente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repetir Transação (Recorrente)"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                app:useMaterialThemeColors="true" />

            <!-- Sub-container de escolhas ao ativar o Switch -->
            <LinearLayout
                android:id="@+id/llSubRecorrencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <RadioGroup
                    android:id="@+id/rgRecorrenciaTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbRecorrenteFixa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="Fixa (Mensal)"
                        android:textColor="@color/textColorPrimary"
                        app:buttonTint="@color/colorPrimary" />

                    <RadioButton
                        android:id="@+id/rbRecorrenteParcelada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Parcelada"
                        android:textColor="@color/textColorPrimary"
                        app:buttonTint="@color/colorPrimary" />
                </RadioGroup>

                <!-- Opção de parcelas -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/parcelasLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Quantidade de Parcelas (Meses)"
                    app:boxBackgroundColor="@color/surfaceColor"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etParcelas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/textColorPrimary"
                        android:inputType="number"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:text="2" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnFinalizarRegisto"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:text="@string/guardar_na_listagem"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            app:cornerRadius="28dp"
            app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/llRecorrenciaOpcoes" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

    <!-- Overlay de Carregamento (Loading Loop) -->
    <FrameLayout
        android:id="@+id/layoutLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ProgressBar
                android:id="@+id/pbLoadingOverlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:indeterminateTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvLoadingOverlayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="A guardar..."
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
