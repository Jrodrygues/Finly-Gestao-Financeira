<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/backgroundColor"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Nome - Alinhado com o cabeçalho (weight 1.5) e permite até 2 linhas -->
    <TextView
        android:id="@+id/tvItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:text="Item"
        android:textColor="@color/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Valor - Alinhado com o cabeçalho (weight 1.3) -->
    <TextView
        android:id="@+id/tvValor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:gravity="end"
        android:paddingEnd="8dp"
        android:fontFeatureSettings="tnum"
        android:text="0,00 €"
        android:textColor="@color/colorNegative"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Data - Alinhado com o cabeçalho (weight 1.0) -->
    <TextView
        android:id="@+id/tvVencimento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:gravity="center"
        android:text="01/01"
        android:textColor="@color/textColorSecondary"
        android:textSize="14sp" />

    <!-- Pago (CheckBox) - Alinhado com o cabeçalho (weight 0.7) -->
    <ImageView
        android:id="@+id/ivStatus"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_weight="0.7"
        android:scaleType="centerInside"
        android:src="@android:drawable/checkbox_off_background"
        android:contentDescription="@string/col_pago"
        app:tint="#BDBDBD" />

</LinearLayout>
