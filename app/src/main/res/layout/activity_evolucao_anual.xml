<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMainEvolucao"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- Cabeçalho com Seletor Integrado -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewHeaderEvolucao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/header_min_height"
        android:background="@color/colorAccent"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackEvolucao"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/btn_voltar_listagem"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitleEvolucao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_evolucao"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnBackEvolucao"
            app:layout_constraintStart_toEndOf="@+id/btnBackEvolucao"
            app:layout_constraintTop_toTopOf="@+id/btnBackEvolucao" />

        <!-- Seletor de Ano Compacto (Badge Integrado) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/anoSelectorLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="115dp"
            android:layout_height="38dp"
            android:layout_marginEnd="16dp"
            app:boxBackgroundColor="#20FFFFFF"
            app:boxCornerRadiusBottomEnd="19dp"
            app:boxCornerRadiusBottomStart="19dp"
            app:boxCornerRadiusTopEnd="19dp"
            app:boxCornerRadiusTopStart="19dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintEnabled="false"
            app:layout_constraintBottom_toBottomOf="@+id/btnBackEvolucao"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnBackEvolucao">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteAno"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="none"
                android:paddingStart="12dp"
                android:paddingEnd="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:maxLines="1"
                android:text="@string/default_year"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:labelFor="@id/autoCompleteAno"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card de Resumo Anual -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResumoAnual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surfaceColor"
        app:layout_constraintTop_toBottomOf="@+id/viewHeaderEvolucao">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_rendas_label"
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary" />
                <TextView
                    android:id="@+id/tvTotalRendaAnual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_value_currency"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/colorPositive" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:background="#33000000" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_despesas_label"
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary" />
                <TextView
                    android:id="@+id/tvTotalDespesaAnual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_value_currency"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/colorNegative" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:background="#33000000" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/saldo_anual_label"
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary" />
                <TextView
                    android:id="@+id/tvSaldoAnual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_value_currency"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/textColorPrimary" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/barChartAnual"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardResumoAnual" />

</androidx.constraintlayout.widget.ConstraintLayout>
