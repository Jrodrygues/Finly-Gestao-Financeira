<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMainEvolucao"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- Cabeçalho com Sombra e Cores Unificadas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewHeaderEvolucao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/header_min_height"
        android:background="@color/headerColor"
        android:elevation="4dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackEvolucao"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/btn_voltar_listagem"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/tvTitleEvolucao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_evolucao"
            android:textColor="@color/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnBackEvolucao"
            app:layout_constraintStart_toEndOf="@+id/btnBackEvolucao"
            app:layout_constraintTop_toTopOf="@+id/btnBackEvolucao" />

        <!-- Seletor de Ano Compacto -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/anoSelectorLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="115dp"
            android:layout_height="38dp"
            android:layout_marginEnd="16dp"
            app:boxBackgroundColor="@color/surfaceColor"
            app:boxCornerRadiusBottomEnd="19dp"
            app:boxCornerRadiusBottomStart="19dp"
            app:boxCornerRadiusTopEnd="19dp"
            app:boxCornerRadiusTopStart="19dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintEnabled="false"
            app:layout_constraintBottom_toBottomOf="@+id/btnBackEvolucao"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnBackEvolucao">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteAno"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="none"
                android:paddingStart="12dp"
                android:paddingEnd="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:maxLines="1"
                android:text="@string/default_year"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/textColorPrimary"
                android:gravity="center_vertical"
                android:labelFor="@id/autoCompleteAno"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card de Resumo Anual -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResumoAnual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surfaceColor"
        app:layout_constraintTop_toBottomOf="@+id/viewHeaderEvolucao">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="16dp"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical"
            android:weightSum="3"
            android:baselineAligned="false">

            <!-- 1. Rendimentos Anual -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/total_rendas_label"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:textColor="@color/textColorSecondary" />

                <TextView
                    android:id="@+id/tvTotalRendaAnual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/default_value_currency"
                    android:textColor="@color/colorPositive"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:background="@color/dividerColor" />

            <!-- 2. Despesas Anual -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/total_despesas_label"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:textColor="@color/textColorSecondary" />

                <TextView
                    android:id="@+id/tvTotalDespesaAnual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/default_value_currency"
                    android:textColor="@color/colorNegative"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:background="@color/dividerColor" />

            <!-- 3. Saldo Anual -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/saldo_anual_label"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:textColor="@color/textColorSecondary" />

                <TextView
                    android:id="@+id/tvSaldoAnual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/default_value_currency"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Gráfico de Barras Anual -->
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/barChartAnual"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cardDetalheMes"
        app:layout_constraintTop_toBottomOf="@+id/cardResumoAnual" />

    <!-- Camada de Escurecimento/Dimming do Gráfico para Plano Grátis -->
    <View
        android:id="@+id/viewChartDimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B3000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/barChartAnual"
        app:layout_constraintBottom_toBottomOf="@+id/barChartAnual"
        app:layout_constraintStart_toStartOf="@+id/barChartAnual"
        app:layout_constraintEnd_toEndOf="@+id/barChartAnual" />

    <!-- Card Flutuante Teaser Premium de Evolução Anual -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOverlayPremiumEvolucao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/colorPrimary"
        app:strokeWidth="1.5dp"
        app:cardBackgroundColor="@color/surfaceColor"
        app:layout_constraintTop_toTopOf="@+id/barChartAnual"
        app:layout_constraintBottom_toBottomOf="@+id/barChartAnual">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Histórico Anual Completo"
                android:textColor="@color/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Acompanhe a evolução de todos os 12 meses e anos anteriores com o Finly Premium."
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerPlanosEvolucao"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/colorPrimary"
                android:paddingHorizontal="24dp"
                android:text="VER PLANOS PREMIUM 🌟"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="22dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card de Detalhe do Mês Selecionado -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetalheMes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surfaceColor"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvTituloDetalheMes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAlignment="center"
                android:text="@string/evolucao_detalhe_mes_dica"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="3"
                android:baselineAligned="false">

                <!-- 1. Rendimentos do Mês -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/label_rendas_mes"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:textColor="@color/textColorSecondary" />

                    <TextView
                        android:id="@+id/tvRendaMesDetalhe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="0,00 €"
                        android:textColor="@color/colorPositive"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/dividerColor" />

                <!-- 2. Despesas do Mês -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/label_despesas_mes"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:textColor="@color/textColorSecondary" />

                    <TextView
                        android:id="@+id/tvDespesaMesDetalhe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="0,00 €"
                        android:textColor="@color/colorNegative"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/dividerColor" />

                <!-- 3. Balanço do Mês -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/label_balanco_mes"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:textColor="@color/textColorSecondary" />

                    <TextView
                        android:id="@+id/tvSaldoMesDetalhe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="0,00 €"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
