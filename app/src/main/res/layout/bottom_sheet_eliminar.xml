<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#DDDDDD" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/dialog_eliminar_recorrencia_titulo"
        android:textColor="@color/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMensagemRecorrente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="@string/dialog_eliminar_recorrencia_msg"
        android:textColor="@color/textColorSecondary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEliminarApenasEste"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/btn_apagar_apenas_este"
        android:textColor="@color/colorAccent"
        android:textSize="15sp"
        app:icon="@drawable/ic_delete"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/colorAccent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEliminarTudo"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/btn_apagar_todos_futuros"
        android:textColor="#F44336"
        android:textSize="15sp"
        app:icon="@drawable/ic_delete"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="#F44336" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelar"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/btn_cancelar_caps"
        android:textColor="@color/textColorSecondary" />

</LinearLayout>
