<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#DDDDDD" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/dialog_editar_recorrencia_titulo"
        android:textColor="@color/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMensagemEditarRecorrente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="@string/dialog_editar_recorrencia_msg"
        android:textColor="@color/textColorSecondary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditarApenasEste"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/btn_editar_apenas_este"
        android:textColor="@color/colorPrimary"
        android:textSize="15sp"
        app:icon="@drawable/ic_edit"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/colorPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditarTodosFuturos"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/btn_editar_todos_futuros"
        android:textColor="@color/colorPrimary"
        android:textSize="15sp"
        app:icon="@drawable/ic_repeat"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/colorPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelarEditar"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAlignment="center"
        android:text="CANCELAR"
        android:textColor="@color/textColorSecondary" />

</LinearLayout>
