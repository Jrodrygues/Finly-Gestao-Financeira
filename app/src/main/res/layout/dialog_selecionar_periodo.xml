<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Título do Modal -->
    <TextView
        android:id="@+id/tvTituloPeriodo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecionar Período"
        android:textColor="@color/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Subtítulo Ano -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Ano"
        android:textColor="@color/textColorSecondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Grelha de Anos (Flexbox / GridLayout de 3 colunas) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgAnos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:singleSelection="true" />

    <!-- Subtítulo Mês -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Mês"
        android:textColor="@color/textColorSecondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Grelha de Meses (ChipGroup de 3 colunas) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgMeses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:singleSelection="true" />

    <!-- Botões de Ação do Modal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelarPeriodo"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancelar"
            android:textColor="@color/textColorSecondary" />

        <Button
            android:id="@+id/btnAplicarPeriodo"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="APLICAR"
            android:textColor="@color/white"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
